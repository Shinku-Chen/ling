     if (!s_event_queue || !s_http_queue || !s_http_lock || miniapp_ui_init() != 0) {
         goto failed;
@@ -1940,6 +2128,12 @@ int miniapp_init(void)
                     &s_buzzer_task) != pdPASS) {
