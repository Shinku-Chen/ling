+#if MINIAPP_HAS_AUDIO
+static bool miniapp_audio_player_active(void)
+{
+    app_player_state_t state = app_player_get_state(miniapp_player);
+    return state == APP_PLAYER_STATE_PREPARING || state == APP_PLAYER_STATE_PREPARED ||
+           state == APP_PLAYER_STATE_PLAYING || state == APP_PLAYER_STATE_PAUSED;
+}
+
+static void miniapp_audio_enqueue(const char *url, miniapp_audio_action_t action, uint32_t generation)
+{
+    if (!s_audio_queue) return;
+    miniapp_audio_command_t command = { .action = action, .generation = generation };
+    if (url) {
+        strncpy(command.url, url, MINIAPP_AUDIO_URL_MAX);
+        command.url[MINIAPP_AUDIO_URL_MAX] = '\0';
+    }
+    (void)xQueueSend(s_audio_queue, &command, 0);
+}
+
+/* Streams outlive a single Lua callback: open, stop and pause are handed to a
+ * dedicated task so they never block the 20 ms Lua tick. Only this task talks
+ * to the shared miniapp player for stream playback. */
+static void miniapp_audio_task(void *argument)
+{
+    (void)argument;
+    miniapp_audio_command_t command;
+    /* The decoder retains the URL string, so the buffer handed to the player has
+     * to stay alive for as long as the stream runs. One instance runs at most
+     * one stream, and a new play request stops the previous one before its URL
+     * is overwritten. */
+    char stream_url[MINIAPP_AUDIO_URL_MAX + 1];
+    uint32_t playing_generation = 0;
+    for (;;) {
+        if (xQueueReceive(s_audio_queue, &command, pdMS_TO_TICKS(200)) == pdTRUE) {
+            if (miniapp_player && command.generation == s_buzzer_generation) {
+                switch (command.action) {
+                case MINIAPP_AUDIO_PLAY:
+                    /* One stream per instance: a new play request replaces the old one. */
+                    if (miniapp_audio_player_active() && app_player_stop(miniapp_player) != APP_PLAYER_OK) {
+                        LISA_LOGW(TAG, "failed to stop previous audio stream");
+                        break;
+                    }
+                    memcpy(stream_url, command.url, sizeof(stream_url));
+                    if (app_player_play(miniapp_player, stream_url) != APP_PLAYER_OK) {
+                        LISA_LOGW(TAG, "failed to start audio stream");
+                        break;
+                    }
+                    playing_generation = command.generation;
+                    break;
+                case MINIAPP_AUDIO_STOP:
+                    (void)app_player_stop(miniapp_player);
+                    playing_generation = 0;
+                    break;
+                case MINIAPP_AUDIO_PAUSE:
+                    (void)app_player_pause(miniapp_player);
+                    break;
+                case MINIAPP_AUDIO_RESUME:
+                    (void)app_player_resume(miniapp_player);
+                    break;
+                }
+            }
+        }
+        /* The instance that owned the stream was replaced or has exited. */
+        if (playing_generation && playing_generation != s_buzzer_generation) {
+            (void)app_player_stop(miniapp_player);
+            playing_generation = 0;
+        }
+    }
+}
+
+static const char *miniapp_audio_state_name(app_player_state_t state)
+{
+    switch (state) {
+    case APP_PLAYER_STATE_PREPARING: return "preparing";
+    case APP_PLAYER_STATE_PREPARED: return "prepared";
+    case APP_PLAYER_STATE_PLAYING: return "playing";
+    case APP_PLAYER_STATE_PAUSED: return "paused";
+    case APP_PLAYER_STATE_STOPPED: return "stopped";
+    case APP_PLAYER_STATE_ERROR: return "error";
+    default: return "idle";
+    }
+}
+
+static int miniapp_lua_audio_state(lua_State *L)
+{
+    if (!miniapp_player) {
+        lua_pushstring(L, "unavailable");
+        return 1;
+    }
+    lua_pushstring(L, miniapp_audio_state_name(app_player_get_state(miniapp_player)));
+    return 1;
+}
+
+static int miniapp_lua_audio_play(lua_State *L)
+{
+    miniapp_vm_t *vm = miniapp_vm_get(L);
+    size_t len = 0;
+    const char *url = luaL_checklstring(L, 1, &len);
+
+    if (!len || len > MINIAPP_AUDIO_URL_MAX || memchr(url, '\0', len)) {
+        return luaL_error(L, "url must be 1..%u bytes", MINIAPP_AUDIO_URL_MAX);
+    }
+    if (strncmp(url, "http://", 7) != 0 && strncmp(url, "https://", 8) != 0) {
+        return luaL_error(L, "url must start with http:// or https://");
+    }
+    if (strpbrk(url, "\r\n")) {
+        return luaL_error(L, "url must not contain line breaks");
+    }
+    if (vm->faulted || vm->retiring) {
+        return luaL_error(L, "audio unavailable during exit");
+    }
+    if (vm->validating) {
+        /* A candidate that fails to start must not produce sound. */
+        memcpy(vm->pending_audio_url, url, len + 1);
+        vm->pending_audio_play = true;
+        return 0;
+    }
+    miniapp_audio_enqueue(url, MINIAPP_AUDIO_PLAY, s_buzzer_generation);
+    return 0;
+}
+
+static int miniapp_lua_audio_command(lua_State *L, miniapp_audio_action_t action)
+{
+    miniapp_vm_t *vm = miniapp_vm_get(L);
+    if (!vm->validating && !vm->faulted && !vm->retiring) {
+        miniapp_audio_enqueue(NULL, action, s_buzzer_generation);
+    }
+    return 0;
+}
+
+static int miniapp_lua_audio_stop(lua_State *L) { return miniapp_lua_audio_command(L, MINIAPP_AUDIO_STOP); }
+static int miniapp_lua_audio_pause(lua_State *L) { return miniapp_lua_audio_command(L, MINIAPP_AUDIO_PAUSE); }
+static int miniapp_lua_audio_resume(lua_State *L) { return miniapp_lua_audio_command(L, MINIAPP_AUDIO_RESUME); }
+#endif
+
 static int miniapp_lua_tts_speak(lua_State *L)
 {
     miniapp_vm_t *vm = miniapp_vm_get(L);
@@ -1452,6 +1608,16 @@ static void miniapp_open_safe_libraries(lua_State *L)
     miniapp_register_function(L, "buzzer", "play", miniapp_lua_buzzer_play);
 #endif
 
+#if MINIAPP_HAS_AUDIO
+    lua_newtable(L);
